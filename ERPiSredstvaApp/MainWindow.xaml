<Window x:Class="ERPiSredstvaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERPi Sredstva — Osnovna sredstva i sitan inventar"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
        <Border Grid.Column="0">
            <Border.Resources>
                <!-- Thin scrollbar for sidebar -->
                <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="SidebarScrollBarThumb" TargetType="Thumb">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="rectangle" CornerRadius="3"
                                        Background="#40FFFFFF" Margin="2,0" Width="6"
                                        HorizontalAlignment="Center"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="rectangle" Property="Background" Value="#80FFFFFF"/>
                                        <Setter TargetName="rectangle" Property="Width" Value="8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ScrollBar">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource SidebarScrollBarThumb}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1B4332" Offset="0"/>
                    <GradientStop Color="#2D6A4F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,16,20,10">
                    <TextBlock x:Name="TxtBrandTitle" Text="🏢 ERPi Sredstva" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtBrandSubtitle" Text="Osnovna sredstva i sitan inventar" FontSize="11"
                               Foreground="#95D5B2" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle DockPanel.Dock="Top" Height="1" Margin="16,0" Fill="#20FFFFFF"/>

                <!-- Ime firme -->
                <Border DockPanel.Dock="Top" Margin="12,6,12,3"
                        Background="#20FFFFFF" CornerRadius="8" Padding="12,7"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown">
                    <StackPanel>
                        <TextBlock Text="Firma:" FontSize="10" Foreground="#95D5B2"/>
                        <TextBlock x:Name="ImeFirmeText"
                                   Text="—"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Korisnik info i Odjava -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" Background="#10FFFFFF" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#95D5B2" Margin="0,2,0,0"/>
                        
                        <Button x:Name="BtnOdjava" Grid.Row="4" Content="Odjavi se" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="4,4" Foreground="#95D5B2" BorderBrush="#95D5B2" Click="BtnOdjava_Click" Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Help dugme na dnu -->
                <Button x:Name="BtnPomoc" DockPanel.Dock="Bottom" Content="❓  Pomoć (Uputstvo)"
                        Style="{StaticResource NavButton}" Margin="8,0,8,2"
                        Click="BtnPomoc_Click"/>

                <!-- Verzija dole -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v1.0.0  •  2026"
                           FontSize="11" Foreground="#52B788" TextAlignment="Center" Margin="0,0,0,12"
                           Cursor="Hand" ToolTip="Kliknite za prikaz istorije izmena (Changelog)"
                           MouseLeftButtonDown="VersionText_MouseLeftButtonDown"/>

                <!-- Navigacija -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0">
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock x:Name="HeaderEvidencija" Text="EVIDENCIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,6,0,3"/>
                        <Button x:Name="BtnDashboard" Content="📊  Radna tabla (Početna)"
                                Style="{StaticResource NavButtonActive}"
                                Click="BtnDashboard_Click"/>
                        <Button x:Name="BtnSredstva" Content="🏗️  Osnovna sredstva"
                                Style="{StaticResource NavButton}"
                                Click="BtnSredstva_Click"/>
                        <Button x:Name="BtnKartice" Content="📋  Analitičke kartice"
                                Style="{StaticResource NavButton}"
                                Click="BtnKartice_Click"/>
                        <Button x:Name="BtnDobavljaci" Content="🏢  Dobavljači"
                                Style="{StaticResource NavButton}"
                                Click="BtnDobavljaci_Click"/>

                        <TextBlock x:Name="HeaderPromene" Text="PROMENE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,10,0,3"/>
                        <Button x:Name="BtnPrijava" Content="📥  Prijava sredstava"
                                Style="{StaticResource NavButton}"
                                Click="BtnPrijava_Click"/>
                        <Button x:Name="BtnRashod" Content="📤  Rashod i promene"
                                Style="{StaticResource NavButton}"
                                Click="BtnRashod_Click"/>

                        <TextBlock x:Name="HeaderObracuni" Text="OBRAČUNI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,10,0,3"/>
                        <Button x:Name="BtnAmortizacija" Content="📊  Amortizacija"
                                Style="{StaticResource NavButton}"
                                Click="BtnAmortizacija_Click"/>
                        <Button x:Name="BtnRevalorizacija" Content="📈  Revalorizacija"
                                Style="{StaticResource NavButton}"
                                Click="BtnRevalorizacija_Click"/>

                        <TextBlock x:Name="HeaderIzvestaji" Text="IZVEŠTAJI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,10,0,3"/>
                        <Button x:Name="BtnPopis" Content="📄  Popis sredstava"
                                Style="{StaticResource NavButton}"
                                Click="BtnPopis_Click"/>
                        <Button x:Name="BtnRekap" Content="📑  Rekapitulacija"
                                Style="{StaticResource NavButton}"
                                Click="BtnRekap_Click"/>

                        <TextBlock x:Name="HeaderPodesavanja" Text="PODEŠAVANJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,10,0,3"/>
                        <Button x:Name="BtnFirme" Content="🏢  Upravljanje firmama"
                                Style="{StaticResource NavButton}"
                                Click="BtnFirme_Click"/>
                        <Button x:Name="BtnKorisnici" Content="👥  Korisnici"
                                Style="{StaticResource NavButton}"
                                Click="BtnKorisnici_Click"/>
                        <Button x:Name="BtnPodesavanja" Content="⚙️  Podešavanja"
                                Style="{StaticResource NavButton}"
                                Click="BtnPodesavanja_Click"/>
                                
                        <TextBlock x:Name="HeaderDokumentacija" Text="DOKUMENTACIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#52B788" Margin="24,10,0,3"/>
                        <Button x:Name="BtnChangelog" Content="📋  Istorija izmena"
                                Style="{StaticResource NavButton}"
                                Click="BtnChangelog_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ SADRŽAJ ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidebar" Content="☰" FontSize="16" FontWeight="Bold" Width="36" Height="36"
                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand"
                            ToolTip="Sklopi / Proširi bočni meni (Ctrl+M)" Click="BtnToggleSidebar_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource SurfaceBrush}"/>
        </Grid>
    </Grid>
</Window>
