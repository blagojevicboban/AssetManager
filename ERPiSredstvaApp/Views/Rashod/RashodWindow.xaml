<Window x:Class="ERPiSredstvaApp.Views.Rashod.RashodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nalog rashoda" Height="680" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Naslov -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Header kartice -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Forma za dodavanje -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>      <!-- Lista stavki -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Akcije -->
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Novi Nalog Rashoda" Style="{StaticResource PageTitle}"/>
        </StackPanel>

        <!-- Header: Br. naloga, Datum, Dokument -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Broj naloga" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBrojNaloga" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Datum" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDatum" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Broj dokumenta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDokumentBroj" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Forma za dodavanje stavke -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,14" x:Name="GridNovaStavka">
            <StackPanel>
                <TextBlock Text="DODAVANJE SREDSTVA U NALOG" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Osnovno sredstvo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbSredstvo" Height="28" IsEditable="True"
                                  DisplayMemberPath="Prikaz" SelectedValuePath="Id"
                                  SelectionChanged="CmbSredstvo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tip promene" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTipPromene" Height="28"
                                  DisplayMemberPath="Naziv" SelectedValuePath="Vrednost"
                                  SelectionChanged="CmbTipPromene_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="LblPodaci" Text="Vrednost / Količina" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPodaci" Height="28" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Sadašnja vr." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtSadasnja" Text="0.00" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="8" Content="+ Dodaj" Style="{StaticResource PrimaryButton}"
                            Height="28" Width="80" VerticalAlignment="Bottom" x:Name="BtnDodaj"
                            Click="BtnDodaj_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lista stavki -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DgStavke" AutoGenerateColumns="False"
                      IsReadOnly="True" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RedBroj}" Width="40"/>
                    <DataGridTextColumn Header="Inv. Br." Binding="{Binding InventarskiBroj}" Width="100"/>
                    <DataGridTextColumn Header="Naziv sredstva" Binding="{Binding NazivSredstva}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="Tip promene" Binding="{Binding TipTekst}" Width="160"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Dokument" Binding="{Binding DokumentBroj}" Width="90"/>
                    <DataGridTextColumn Header="Podaci" Binding="{Binding Podaci, StringFormat=N2}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="OJ" Binding="{Binding ObracunskaJedinica}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Akcije -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Zatvori" Style="{StaticResource SecondaryButton}" Height="34" Width="100"
                    Margin="0,0,12,0" Click="BtnZatvori_Click"/>
            <Button x:Name="BtnStampa" Content="🖨️" Style="{StaticResource SecondaryButton}"
                    Height="34" Width="34" Padding="0" ToolTip="Štampa" Margin="0,0,12,0" Click="BtnStampa_Click"/>
            <Button x:Name="BtnProknjizi" Content="💾 Proknjiži nalog" Style="{StaticResource PrimaryButton}"
                    Height="34" Width="160" Click="BtnProknjizi_Click"/>
        </StackPanel>
    </Grid>
</Window>
