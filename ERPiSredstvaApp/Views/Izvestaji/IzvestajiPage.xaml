<Page x:Class="ERPiSredstvaApp.Views.Izvestaji.IzvestajiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Izveštaji"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Prikaz zavisi od selektovanog izveštaja -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista izveštaja -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border Background="#F0F7F4" CornerRadius="10,10,0,0" Padding="16,12">
                        <TextBlock Text="Dostupni izveštaji" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryLightBrush}"/>
                    </Border>
                    <StackPanel Margin="8">

                        <TextBlock Text="POPISI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="8,8,0,4"/>
                        <Button x:Name="BtnPopisSvihSredstava"
                                Content="📋  Popis svih sredstava"
                                Style="{StaticResource NavButton}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="BtnPopis_Click" Tag="popis"/>

                        <TextBlock Text="REKAPITULACIJE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="8,10,0,4"/>
                        <Button x:Name="BtnRekapKonto"
                                Content="📊  Rekapitulacija po kontima"
                                Style="{StaticResource NavButton}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="BtnRekap_Click" Tag="konto"/>
                        <Button x:Name="BtnRekapOJ"
                                Content="🏢  Rekapitulacija po OJ"
                                Style="{StaticResource NavButton}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="BtnRekap_Click" Tag="oj"/>
                        <Button x:Name="BtnRekapAmGrupa"
                                Content="📈  Rekapitulacija po am. grupi"
                                Style="{StaticResource NavButton}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Click="BtnRekap_Click" Tag="amgrupa"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sadržaj izveštaja -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F0F7F4" CornerRadius="10,10,0,0" Padding="16,12">
                        <Grid>
                            <TextBlock x:Name="IzvestajNaslov" Text="Izaberite izveštaj"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnExport" Content="💾  Export CSV"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="28" Padding="10,4"
                                        IsEnabled="False"
                                        Click="BtnExport_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Placeholder kada nije izabran izveštaj -->
                    <StackPanel x:Name="PlaceholderPanel" Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Izaberite izveštaj iz liste levo"
                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- DataGrid za prikaz -->
                    <DataGrid x:Name="IzvestajGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Visibility="Collapsed"
                              BorderThickness="0"
                              CanUserSortColumns="True"/>

                    <!-- Footer sa zbirom -->
                    <Border Grid.Row="2" Background="#F9FAF9" Padding="16,10"
                            CornerRadius="0,0,10,10" Visibility="{Binding Visibility, ElementName=IzvestajGrid}">
                        <Grid>
                            <TextBlock x:Name="ZbirText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="UKUPNO Nabavna:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UkupnoNabavna" Text="—"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,24,0"/>
                                <TextBlock Text="UKUPNO Sadašnja:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UkupnoSadasnja" Text="—"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
