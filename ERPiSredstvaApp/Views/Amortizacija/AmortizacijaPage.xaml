<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="ERPiSredstvaApp.Views.Amortizacija.AmortizacijaPage"
      Title="Amortizacija"
      Background="{StaticResource SurfaceBrush}">

    <TabControl x:Name="TabControl" >
        <!-- Tab 1: Obracun -->
        <TabItem Header="⚙️ Obracun amortizacije">
            <Grid Margin="28,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Naslov -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Obračun Amortizacije" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Izračunavanje i knjiženje troškova amortizacije za zadati period"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Parametri za obračun -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Period:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CbTipPerioda" Grid.Column="1" Width="170" Height="34" Margin="0,0,16,0" SelectedIndex="0"
                                  SelectionChanged="CbTipPerioda_SelectionChanged">
                            <ComboBoxItem Content="Godišnji (01.01-31.12)"/>
                            <ComboBoxItem Content="1. Kvartal (Q1: 01.01-31.03)"/>
                            <ComboBoxItem Content="2. Kvartal (Q2: 01.04-30.06)"/>
                            <ComboBoxItem Content="3. Kvartal (Q3: 01.07-30.09)"/>
                            <ComboBoxItem Content="4. Kvartal (Q4: 01.10-31.12)"/>
                            <ComboBoxItem Content="Proizvoljni period"/>
                        </ComboBox>

                        <TextBlock Text="Od:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpOd" Grid.Column="3" Width="125" Height="34" Margin="0,0,16,0"/>

                        <TextBlock Text="Do:" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpDo" Grid.Column="5" Width="125" Height="34" Margin="0,0,16,0"/>

                        <TextBlock Text="Pravilo:" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CbPocetakRule" Grid.Column="7" Width="180" Height="34" SelectedIndex="0">
                            <ComboBoxItem Content="Srazmerno po danima"/>
                            <ComboBoxItem Content="Od narednog meseca"/>
                        </ComboBox>

                        <Button Grid.Column="9" Content="⚙️  Obračunaj"
                                Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                Click="BtnObracunaj_Click"/>
                    </Grid>
                </Border>

                <!-- DataGrid sa rezultatima obračuna -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="AmortizacijaGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Šifra" Binding="{Binding LegacySifra}" SortMemberPath="LegacySifra" Width="70"/>
                                <DataGridTextColumn Header="Inv. Broj" Binding="{Binding InventarskiBroj}" SortMemberPath="InventarskiBroj" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Naziv Sredstva" Binding="{Binding Naziv}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Stopa %" Binding="{Binding StopaAmortizacije, StringFormat=N2}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Nabavna Vr." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Rezidualna Vr." Binding="{Binding RezidualnaVrednost, StringFormat=N2}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Prethodna Isp." Binding="{Binding PrethodnaIspravka, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Nova amortizacija (Highlight) -->
                                <DataGridTextColumn Header="Nova Amortizacija" Binding="{Binding NovaAmortizacija, StringFormat=N2}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Sadašnja Vr." Binding="{Binding SadasnjaVrednost, StringFormat=N2}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Placeholder kada nema obračuna -->
                        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📉" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unesite datume i kliknite na 'Obračunaj'"
                                       FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer / Akcije -->
                <Border Grid.Row="5" Background="#F9FAF9" Padding="20,12" Margin="0" CornerRadius="0,0,10,10">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" Direction="90" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Zbirna nova amortizacija:" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UkupnaNovaAmortizacijaTxt" Text="0.00" FontSize="18" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock x:Name="BrojStavkiTxt" Text="" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnStampa" Content="🖨️"
                                    Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" ToolTip="Štampa" Margin="0,0,12,0"
                                    IsEnabled="False" Click="BtnStampa_Click"/>
                            <Button x:Name="BtnExport" Content="💾 Eksport (CSV)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,12,0"
                                    IsEnabled="False" Click="BtnExport_Click"/>

                            <Button x:Name="BtnProknjizi" Content="✔️ Proknjiži obračun"
                                    Style="{StaticResource PrimaryButton}" Height="34" Background="{StaticResource SuccessBrush}"
                                    IsEnabled="False" Click="BtnProknjizi_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- Tab 2: Lista amortizacije -->
        <TabItem Header="📋 Lista amortizacije">
            <Grid Margin="28,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Naslov -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Lista Amortizacijа" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Pregled amortizacija po godinama"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Dropdown filter godine -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Filtriraj godinu:" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" x:Name="CbGodine" Width="100" Height="34"
                                  SelectionChanged="CbGodine_SelectionChanged"
                                  IsEditable="False" IsReadOnly="True"/>
                                  
                        <Button Grid.Column="3" x:Name="BtnStampaLista" Content="🖨️"
                                Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" ToolTip="Štampa" Margin="0,0,0,0"
                                Click="BtnStampaLista_Click"/>
                    </Grid>
                </Border>

                <!-- TabView za grupe po godinama -->
                <DataGrid x:Name="IzabranaAmortizacijaGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                BorderThickness="0"
                CanUserSortColumns="True" Grid.RowSpan="3" VerticalAlignment="Top" Margin="0,1,0,0" Grid.Row="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding LegacySifra}" SortMemberPath="LegacySifra" Width="70"/>
                        <DataGridTextColumn Header="Inv. Broj" Binding="{Binding InventarskiBroj}" SortMemberPath="InventarskiBroj" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Naziv Sredstva" Binding="{Binding Naziv}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="Stopa %" Binding="{Binding StopaAmortizacije, StringFormat=N2}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nabavna Vr." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Prethodna Isp." Binding="{Binding PrethodnaIspravka, StringFormat=N2}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Nova amortizacija (Highlight) -->
                        <DataGridTextColumn Header="Nova Amortizacija" Binding="{Binding NovaAmortizacija, StringFormat=N2}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Sadašnja Vr." Binding="{Binding SadasnjaVrednost, StringFormat=N2}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- Tab 3: Poreska amortizacija (Obrazac OA) -->
        <TabItem Header="🏛️ Poreska amortizacija (Obrazac OA)">
            <Grid Margin="28,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Naslov -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Poreska Amortizacija i Obrazac OA" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Obračun po Zakonu o porezu na dobit pravnih lica i generisanje Obrasca OA za poreski bilans (PB-1)"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Toolbar za poresku amortizaciju -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Godina obračuna:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtPoreskaGodina" Grid.Column="1" Width="90" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>

                        <Button Grid.Column="3" Content="⚙️  Obračunaj Poresku Amortizaciju"
                                Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                Click="BtnObracunajPoresku_Click"/>

                        <Button Grid.Column="5" x:Name="BtnStampaOA" Content="🖨️"
                                Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" IsEnabled="False" ToolTip="Obrazac OA (PDF)"
                                Click="BtnStampaOA_Click"/>

                        <Button Grid.Column="7" x:Name="BtnStampaPB1" Content="🖨️"
                                Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" IsEnabled="False" ToolTip="PB-1 Izveštaj (PDF)" Margin="10,0,0,0"
                                Click="BtnStampaPB1_Click"/>

                        <Button Grid.Column="9" x:Name="BtnMasovnaDodelaGrupa" Content="🪄  Masovna Dodela Grupa"
                                Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Margin="10,0,0,0"
                                Click="BtnMasovnaDodelaGrupa_Click"/>
                    </Grid>
                </Border>

                <!-- Tabela Poreske Amortizacije sa Poreskim Razlikama -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="PoreskaAmortizacijaGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Šifra" Binding="{Binding LegacySifra}" SortMemberPath="LegacySifra" Width="65"/>
                            <DataGridTextColumn Header="Inv. Broj" Binding="{Binding InventarskiBroj}" SortMemberPath="InventarskiBroj" Width="90"/>
                            <DataGridTextColumn Header="Naziv Sredstva" Binding="{Binding Naziv}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Por. Grupa" Binding="{Binding PoreskaGrupa}" Width="80"/>
                            <DataGridTextColumn Header="Por. Stopa %" Binding="{Binding PoreskaStopa, StringFormat=N2}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Poreska Osnovica" Binding="{Binding PoreskaNabavnaVrednost, StringFormat=N2}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Preth. Por. Ispravka" Binding="{Binding PrethodnaPoreskaIspravka, StringFormat=N2}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Poreska Amortizacija" Binding="{Binding NovaPoreskaAmortizacija, StringFormat=N2}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Por. Neotpisano" Binding="{Binding PoreskaNeotpisanaVrednost, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Rač. Amortizacija" Binding="{Binding RacunovodstvenaAmortizacija, StringFormat=N2}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Poreska Razlika (PB-1)" Binding="{Binding PrivremenaPoreskaRazlika, StringFormat=N2}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Footer rezime za Poresku amortizaciju -->
                <Border Grid.Row="5" Background="#F8FAFC" Padding="20,12" Margin="0" CornerRadius="0,0,10,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Ukupna Poreska Amortizacija:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtUkupnaPoreskaAmortizacija" Text="0.00" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,24,0"/>

                        <TextBlock Text="Ukupna Privremena Razlika (Rač. − Por.):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtUkupnaPoreskaRazlika" Text="0.00" FontWeight="Bold" FontSize="16" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Page>