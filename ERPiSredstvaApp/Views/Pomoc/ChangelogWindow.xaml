<Window x:Class="ERPiSredstvaApp.Views.Pomoc.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Istorija Izmena (Changelog) — ERPiSredstva" 
        Height="620" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16" Background="#1E3A8A">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📋 Istorija Izmena i Novina (Changelog)" 
                           FontSize="18" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAppVersion" Text="v1.0.43" 
                           FontSize="13" FontWeight="SemiBold" Foreground="#93C5FD" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT (SCROLLABLE CHANGELOG LIST) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <WebBrowser x:Name="WbChangelog" />
        </Border>

        <!-- FOOTER -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock Text="ERPiSredstva © 2026 — Autor: Blagojević Boban" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>

            <Button Content="Zatvori" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="110" Height="36" 
                    Click="BtnZatvori_Click" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
