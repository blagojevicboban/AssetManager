<Page x:Class="ERPiSredstvaApp.Views.Revalorizacija.RevalorizacijaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Obračun revalorizacije"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Parametri za obračun -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Osnovni parametri -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OPŠTI PARAMETRI" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Period od:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker x:Name="DpOd" Grid.Column="1" Height="32"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Period do:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker x:Name="DpDo" Grid.Column="1" Height="32"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Godišnji koeficijent:" VerticalAlignment="Center" Margin="0,0,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="(primenjuje se na stanje sredstava na početku godine i redovnu amortizaciju)" 
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    
                    <TextBox x:Name="TxtGodisnjiKoef" Text="1.00" Height="34" 
                             FontFamily="Consolas" FontWeight="Bold" FontSize="16"
                             TextAlignment="Right" Padding="0,0,10,0"/>

                    <Button Content="⚙️ Obračunaj" Margin="0,20,0,0"
                            Style="{StaticResource PrimaryButton}" Height="38"
                            Click="BtnObracunaj_Click"/>
                </StackPanel>
            </Border>

            <!-- Mesečni koeficijenti -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="MESEČNI KOEFICIJENTI (za promene u toku godine)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                    
                    <UniformGrid Columns="3" Rows="4" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="01 Januar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec1" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="02 Februar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec2" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="03 Mart" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec3" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="04 April" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec4" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="05 Maj" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec5" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="06 Jun" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec6" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="07 Jul" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec7" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="08 Avgust" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec8" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="09 Septembar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec9" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="10 Oktobar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec10" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="11 Novembar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec11" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="12 Decembar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtMesec12" Text="1.00" Height="32" TextAlignment="Right" FontFamily="Consolas" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid sa rezultatima obračuna -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="RevalorizacijaGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding LegacySifra}" SortMemberPath="LegacySifra" Width="70"/>
                        <DataGridTextColumn Header="Inv. Broj" Binding="{Binding InventarskiBroj}" SortMemberPath="InventarskiBroj" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Naziv Sredstva" Binding="{Binding Naziv}" Width="*" MinWidth="180"/>
                        
                        <DataGridTextColumn Header="Stara Nabavna" Binding="{Binding StaraNabavna, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="Stara Ispravka" Binding="{Binding StaraIspravka, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Efekat Nabavna" Binding="{Binding EfekatNabavna, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="Efekat Ispravka" Binding="{Binding EfekatIspravka, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Nova Sadašnja" Binding="{Binding NovaSadasnja, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Placeholder -->
                <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Unesite koeficijente i kliknite na 'Obračunaj'"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Akcije -->
        <Border Grid.Row="5" Background="#F9FAF9" Padding="20,12" Margin="0" CornerRadius="0,0,10,10">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" Direction="90" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Efekat reval. na Nabavnu:" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UkupnoEfekatNabavnaTxt" Text="0.00" FontSize="18" FontWeight="Bold"
                               FontFamily="Consolas" Foreground="{StaticResource PrimaryLightBrush}"
                               VerticalAlignment="Center" Margin="10,0,20,0"/>

                    <TextBlock Text="Efekat na Ispravku:" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UkupnoEfekatIspravkaTxt" Text="0.00" FontSize="18" FontWeight="Bold"
                               FontFamily="Consolas" Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnStampa" Content="🖨️"
                            Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" ToolTip="Štampa" Margin="0,0,12,0"
                            IsEnabled="False" Click="BtnStampa_Click"/>
                    <Button x:Name="BtnExport" Content="💾 Eksport (CSV)"
                            Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,12,0"
                            IsEnabled="False" Click="BtnExport_Click"/>
                    
                    <Button x:Name="BtnProknjizi" Content="✔️ Proknjiži obračun"
                            Style="{StaticResource PrimaryButton}" Height="34" Background="{StaticResource SuccessBrush}"
                            IsEnabled="False" Click="BtnProknjizi_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
