<Page x:Class="ERPiSredstvaApp.Views.Podesavanja.PodesavanjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Podešavanja" Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <!-- Modern TabControl / TabItem styles -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB: Rezervna kopija -->
            <TabItem Header="💾 Rezervna kopija">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                        <StackPanel>
                            <!-- KARTICA 1: Kreiranje rezervne kopije -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="💾 Kreiranje rezervne kopije (Backup)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Sačuvajte trenutno stanje baze podataka na sigurnu lokaciju." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="Trenutna lokacija aktivne baze podataka:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAktivnaBazaPath" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Preporučeno ime za rezervnu kopiju:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPredlozenoIme" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,24"/>

                                    <Button x:Name="BtnKreirajBackup" Content="💾 Napravi rezervnu kopiju baze podataka" Style="{StaticResource PrimaryButton}" Height="40" Click="BtnKreirajBackup_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- KARTICA 2: Vraćanje baze podataka -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🔄 Vraćanje baze iz datoteke (Restore)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Učitajte prethodno sačuvanu bazu podataka iz izabranog fajla." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                    <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ VAŽNO UPOZORENJE" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4"/>
                                            <TextBlock Text="Vraćanje podataka iz rezervne kopije će u potpunosti zameniti sve trenutne podatke u sistemu za aktivnu firmu! Pre prepisivanja, biće automatski napravljena sigurnosna kopija trenutnog stanja baze." 
                                                       TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BtnIzaberiVrati" Content="📂 Izaberi i vrati bazu podataka iz kopije" Style="{StaticResource SecondaryButton}" Height="40" Click="BtnIzaberiVrati_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- KARTICA 3: Automatske rezervne kopije -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Automatske rezervne kopije (Auto-backup)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Izaberite koliko često želite da aplikacija automatski pravi sigurnosnu kopiju." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="Frekvencija automatskog kreiranja:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbAutoBackup" Height="36" Padding="12,0" SelectionChanged="CmbAutoBackup_SelectionChanged">
                                        <ComboBoxItem Content="Nikad (Isključeno)"/>
                                        <ComboBoxItem Content="Pri svakom izlasku iz aplikacije"/>
                                        <ComboBoxItem Content="Jednom dnevno (prvi izlazak u danu)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- DESNO: Istorija -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="⏳ Istorija sigurnosnih i auto-kopija" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Lista kopija kreiranih pri pokretanju ili pre operacije vraćanja. Selektujte jednu da biste je brzo vratili." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                            </StackPanel>

                            <DataGrid x:Name="LstIstorijaKopija" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                      HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tip kopije" Binding="{Binding Tip}" Width="120"/>
                                    <DataGridTextColumn Header="Datum kreiranja" Binding="{Binding DatumPrikaz}" Width="140"/>
                                    <DataGridTextColumn Header="Veličina" Binding="{Binding VelicinaPrikaz}" Width="90"/>
                                    <DataGridTextColumn Header="Naziv fajla" Binding="{Binding NazivFajla}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" x:Name="BtnVratiIzIstorije" Content="🔄 Vrati bazu iz izabrane kopije" 
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnVratiIzIstorije_Click"/>
                                
                                <Button Grid.Column="1" x:Name="BtnOtvoriFolder" Content="📂 Otvori folder sa kopijama" 
                                        Style="{StaticResource SecondaryButton}" Padding="16,8" Click="BtnOtvoriFolder_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB: Postavke programa -->
            <TabItem Header="💻 Postavke programa">
                <Grid Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Postavke programa" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Opšte postavke vezane za izgled i ponašanje programa." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                                
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Pokretanje programa maksimizovano" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Program će se automatski otvoriti u celom ekranu pri sledećem pokretanju." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartMaximized" Grid.Column="1" VerticalAlignment="Center" Checked="ChkStartMaximized_Changed" Unchecked="ChkStartMaximized_Changed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- TAB: Uvoz iz starog programa -->
            <TabItem Header="📥 Uvoz iz starog programa">
                <Grid Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Uvoz podataka iz starog (DOS/FoxPro) programa" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Izaberite folder u kojem se nalaze podaci iz starog programa (npr. C:\arhibEL\SREDSTVA). Sistem će očitati listu firmi (KORISNIC.DBF) i ponuditi Vam uvoz izabranih firmi." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtStarProgramFolder" Grid.Column="0" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="8,0"/>
                                    <Button x:Name="BtnIzaberiStariFolder" Grid.Column="1" Content="📂 Izaberi folder" Style="{StaticResource SecondaryButton}" Height="32" Click="BtnIzaberiStariFolder_Click"/>
                                </Grid>

                                <DataGrid x:Name="LstFirmeIzStarogPrograma" AutoGenerateColumns="False" IsReadOnly="True" 
                                          HeadersVisibility="Column" SelectionMode="Single" Margin="0,16,0,16" Height="200" Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra}" Width="60"/>
                                        <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*"/>
                                        <DataGridTextColumn Header="PIB" Binding="{Binding Pib}" Width="100"/>
                                        <DataGridTextColumn Header="MB" Binding="{Binding MaticniBroj}" Width="100"/>
                                        <DataGridTemplateColumn Header="Akcija" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📥 Uvezi" Click="BtnUveziFirmu_Click" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0" Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8" Margin="-24,0,-24,-16">
            <TextBlock x:Name="StatusMessage" Text="Spremno." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Page>
