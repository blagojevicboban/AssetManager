<Application x:Class="SredstvaApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SredstvaApp"
             xmlns:conv="clr-namespace:SredstvaApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <conv:BooleanToStatusColorConverter x:Key="BooleanToStatusColorConverter"/>
            <conv:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
            <conv:BooleanToDeactivateTextConverter x:Key="BooleanToDeactivateTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
