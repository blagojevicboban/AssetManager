<Page x:Class="SredstvaApp.Views.Rashod.PrijavaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Prijava Sredstava"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Naslov -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Stat kartice -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Prijava Sredstava" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="SubtitleText" Text="Učitavanje..."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Stat kartice -->
        <UniformGrid Grid.Row="2" Columns="5">
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UKUPNO NALOGA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatUkupno" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UKUPNO STAVKI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatStavki" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UKUPNA NABAVNA VR." FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatUkupnaVrednost" Text="—" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="PROKNJIŽENO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatKnjizeno" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="NA ČEKANJU" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatCekanje" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Toolbar -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Width="260" Height="34"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Pretraga po broju naloga ili dobavljaču"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Nova prijava" Style="{StaticResource PrimaryButton}"
                            Height="34" Click="BtnNova_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid section -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- PrijavaGrid -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="PrijavaGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" BorderThickness="0" Background="Transparent"
                          CanUserSortColumns="True"
                          SelectionChanged="PrijavaGrid_SelectionChanged"
                          MouseDoubleClick="PrijavaGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br. Naloga" Binding="{Binding BrojNaloga}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Dobavljač" Binding="{Binding DobavljacNaziv}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Datum aktiv." Binding="{Binding DatumAktiviranja, StringFormat=dd.MM.yyyy}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Br. stavki" Binding="{Binding BrojStavki}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ukupna nabavna vr." Binding="{Binding UkupnaNabavnaVrednost, StringFormat=N2}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KnjizenTekst}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Knjizen}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Knjizen}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detalji (Stavke) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDetaljiNaslov" Text="Izaberite nalog" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✏️ Uredi Nalog" Style="{StaticResource SecondaryButton}" Height="30" Click="BtnEditNalog_Click"/>
                    </Grid>
                    
                    <DataGrid x:Name="StavkeGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Red" Binding="{Binding RedBroj}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Naziv (Sredstvo)" Binding="{Binding SredstvoNaziv}" Width="*"/>
                            <DataGridTextColumn Header="Kol." Binding="{Binding Kolicina}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Vrednost" Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="7" Padding="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Dupli klik na nalog za pregled"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Page>
