<Window x:Class="SredstvaApp.Views.Rashod.PrijavaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prijava novog sredstva" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nalog Prijave" Style="{StaticResource PageTitle}"/>

        <!-- MASTER: Zaglavlje Naloga -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="PODACI O NALOGU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Broj naloga" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrojNaloga" Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Datum aktiviranja" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDatum" Height="28"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Dobavljač" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDobavljac" Height="28" DisplayMemberPath="OpisKonta" SelectedValuePath="Id"/>
                    </StackPanel>

                    <Button x:Name="BtnNoviDobavljac" Grid.Column="6" Content="+ Novi dobavljač" Style="{StaticResource SecondaryButton}" Height="28" Padding="16,2" VerticalAlignment="Bottom" Click="BtnNoviDobavljac_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DETAIL: Tabela Stavki -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DataGrid x:Name="DgStavke" ItemsSource="{Binding Stavke}" AutoGenerateColumns="False" 
                      IsReadOnly="True" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RedBroj}" Width="40"/>
                    <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra}" Width="60"/>
                    <DataGridTextColumn Header="Inv. Br." Binding="{Binding InventarskiBroj}" Width="100"/>
                    <DataGridTextColumn Header="Naziv sredstva" Binding="{Binding Naziv}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, StringFormat=N0}" Width="60"/>
                    <DataGridTextColumn Header="Faktura" Binding="{Binding BrojFakture}" Width="90"/>
                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="80"/>
                    <DataGridTextColumn Header="Nabavna Vr." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Otpisana Vr." Binding="{Binding OtpisanaVrednost, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Stopa %" Binding="{Binding StopaAmortizacije, StringFormat=N2}" Width="70"/>
                    <DataGridTextColumn Header="Am. Gr." Binding="{Binding AmortizacionaGrupa}" Width="60"/>
                    <DataGridTextColumn Header="OJ" Binding="{Binding ObracunskaJedinica}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ADD NEW ITEM -->
        <Border x:Name="GridNovaStavka" Grid.Row="6" Style="{StaticResource Card}" Padding="16" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="DODAVANJE SREDSTVA U NALOG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Inv. Br." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInvBroj" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Naziv sredstva" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNaziv" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Nabavna vr." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNabavna" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Stopa %" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStopa" Height="28"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Am. Grupa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGrupa" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Konto" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtKonto" Height="28" Width="90" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4">
                        <TextBlock Text="Poreska Grupa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPoreskaGrupa" Height="28" DisplayMemberPath="Naziv" SelectedValuePath="Kod"
                                  ToolTip="{Binding SelectedItem.Opis, RelativeSource={RelativeSource Self}}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="ToolTip" Value="{Binding Opis}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                    
                    <Button x:Name="BtnDodaj" Grid.Row="2" Grid.Column="6" Content="Dodaj" Style="{StaticResource SecondaryButton}" Height="28" Padding="16,2" VerticalAlignment="Bottom" Click="BtnDodajStavku_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- FOOTER: Buttons -->
        <DockPanel Grid.Row="8" LastChildFill="False">
            <Button Content="Zatvori" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Click="BtnZatvori_Click" DockPanel.Dock="Left"/>
            
            <Button x:Name="BtnProknjizi" Content="Proknjiži Nalog" Style="{StaticResource PrimaryButton}" Background="{StaticResource DangerBrush}" Width="140" Height="36" Click="BtnProknjizi_Click" DockPanel.Dock="Right"/>
            <Button x:Name="BtnStampa" Content="🖨 Štampa (PDF)" Style="{StaticResource SecondaryButton}" Width="140" Height="36" Margin="0,0,10,0" Click="BtnStampa_Click" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
