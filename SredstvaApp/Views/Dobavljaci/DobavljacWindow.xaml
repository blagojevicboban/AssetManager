<Window x:Class="SredstvaApp.Views.Dobavljaci.DobavljacWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novi dobavljač" Height="439" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="NoResize" KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Novi dobavljač" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Konto" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtKonto" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Opis konta (naziv dobavljača)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtOpisKonta" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Ulica i broj" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUlica" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="Mesto i broj" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMesto" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Otkaži" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,12,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="Dodaj" Style="{StaticResource PrimaryButton}" Width="100" Height="36" Click="BtnDodaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
