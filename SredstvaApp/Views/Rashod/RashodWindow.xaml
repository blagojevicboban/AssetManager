<Window x:Class="SredstvaApp.Views.Rashod.RashodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rashod i promene na sredstvima" Height="580" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Unos promene (Nalog rashoda)" Style="{StaticResource PageTitle}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <!-- DOKUMENT -->
                <TextBlock Text="PODACI O DOKUMENTU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Broj naloga" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrojNaloga" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Datum" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDatum" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Broj dokumenta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDokumentBroj" Height="28"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,8,0,16"/>

                <!-- SREDSTVO -->
                <TextBlock Text="IZBOR SREDSTVA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Osnovno sredstvo (pretraga po inv. broju i nazivu)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbSredstvo" Height="32" 
                              IsEditable="True" 
                              DisplayMemberPath="Prikaz" SelectedValuePath="Id"
                              SelectionChanged="CmbSredstvo_SelectionChanged"/>
                </StackPanel>

                <!-- Prikaz trenutnog stanja -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Trenutna Nabavna" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtTrenutnaNabavna" Text="0.00" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Trenutna Ispravka" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtTrenutnaIspravka" Text="0.00" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sadašnja vrednost" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtTrenutnaSadasnja" Text="0.00" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                <!-- VRSTA PROMENE -->
                <TextBlock Text="PODACI O PROMENI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tip promene" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTipPromene" Height="28" 
                                  DisplayMemberPath="Naziv" SelectedValuePath="Vrednost"
                                  SelectionChanged="CmbTipPromene_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="LblPodaci" Text="Vrednost / Količina" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPodaci" Height="28" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
                
                <TextBlock x:Name="OpisPromeneInfo" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Akcije -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Odustani" Style="{StaticResource SecondaryButton}" Height="34" Width="100" Margin="0,0,12,0" Click="BtnOdustani_Click"/>
            <Button Content="💾 Sačuvaj i proknjiži" Style="{StaticResource PrimaryButton}" Height="34" Width="160" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
