<Page x:Class="SredstvaApp.Views.Rashod.PrijavaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Prijava Sredstava"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Prijava Sredstava" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="SubtitleText" Text="Učitavanje..." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Search / Filter -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Nova prijava" Style="{StaticResource PrimaryButton}" Click="BtnNova_Click"/>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="18"/>
                    <TextBox x:Name="SearchBox" Width="300" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="Pretraga po broju naloga ili dobavljaču" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <DataGrid x:Name="PrijavaGrid" AutoGenerateColumns="False" 
                          IsReadOnly="True" BorderThickness="0" Background="Transparent"
                          SelectionChanged="PrijavaGrid_SelectionChanged" MouseDoubleClick="PrijavaGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br. Naloga" Binding="{Binding BrojNaloga}" Width="100"/>
                        <DataGridTextColumn Header="Dobavljač" Binding="{Binding DobavljacNaziv}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Datum Aktiv." Binding="{Binding DatumAktiviranja, StringFormat=dd.MM.yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Br. Stavki" Binding="{Binding BrojStavki}" Width="90"/>
                        <DataGridTextColumn Header="Ukupna Nabavna Vr." Binding="{Binding UkupnaNabavnaVrednost, StringFormat=N2}" Width="160"/>
                        <DataGridTextColumn Header="Proknjižen" Binding="{Binding KnjizenTekst}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="16,8">
                    <TextBlock x:Name="StatusText" Text="Spremno." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
