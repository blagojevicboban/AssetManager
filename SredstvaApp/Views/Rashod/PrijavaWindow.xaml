<Window x:Class="SredstvaApp.Views.Rashod.PrijavaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prijava novog sredstva" Height="580" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Unos novog sredstva" Style="{StaticResource PageTitle}"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <!-- DOKUMENT -->
                <TextBlock Text="PODACI O DOKUMENTU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Broj naloga / dokumenta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrojNaloga" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dobavljač" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDobavljac" Height="28" DisplayMemberPath="OpisKonta" SelectedValuePath="Id"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Datum nabavke" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpNabavka" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Datum aktiviranja" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpAktiviranje" Height="28"/>
                    </StackPanel>
                </Grid>

                <!-- SREDSTVO -->
                <TextBlock Text="OSNOVNO SREDSTVO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Inventarski broj" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInventarskiBroj" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Naziv sredstva" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNaziv" Height="28"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nabavna vrednost" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNabavna" Height="28" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stopa amort. (%)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStopa" Height="28" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Amort. grupa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGrupa" Height="28"/>
                    </StackPanel>
                </Grid>

                <!-- KLASIFIKACIJA -->
                <TextBlock Text="KLASIFIKACIJA (KARTICA)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Konto" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtKonto" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Obračunska jedinica (OJ)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtOJ" Height="28"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Akcije -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Odustani" Style="{StaticResource SecondaryButton}" Height="34" Width="100" Margin="0,0,12,0" Click="BtnOdustani_Click"/>
            <Button Content="💾 Sačuvaj i proknjiži" Style="{StaticResource PrimaryButton}" Height="34" Width="160" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
