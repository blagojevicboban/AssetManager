<Page x:Class="SredstvaApp.Views.Kartice.KarticaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kartica sredstva"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Naslov sa back dugmetom -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="← Nazad" Style="{StaticResource SecondaryButton}"
                    Height="32" Padding="12,6" Click="BtnNazad_Click"
                    VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="NaslovText"
                           Text="Analitička kartica" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="Učitavanje..."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>

        <!-- Info kartice (stat boxes) -->
        <UniformGrid Grid.Row="2" Columns="4" HorizontalAlignment="Stretch">

            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="NABAVNA VREDNOST" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="NabavnaText" Text="—"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas"/>
                    <TextBlock Text="RSD" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="ISPRAVKA VREDNOSTI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="IspravkaText" Text="—"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               FontFamily="Consolas"/>
                    <TextBlock Text="RSD" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SADAŠNJA VREDNOST" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SadasnjaText" Text="—"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas"/>
                    <TextBlock Text="RSD" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="STOPA AMORTIZACIJE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StopaText" Text="—"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}"/>
                    <TextBlock Text="godišnje" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Meta podaci sredstva -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="INVENTARSKI BROJ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="InvBrText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AMORT. GRUPA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="AmGrupaText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DATUM AKTIVIRANJA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DatumAktText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="BROJ STAVKI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="BrojStavkiText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela kartica -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Naslov tabele -->
                <Border Grid.Row="0" Background="#F0F7F4" CornerRadius="10,10,0,0" Padding="16,10">
                    <TextBlock Text="Hronologija promena" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryLightBrush}"/>
                </Border>

                <DataGrid x:Name="KarticaGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Red br." Binding="{Binding RedBroj}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Opis promene" Binding="{Binding OpisPromene}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="OJ" Binding="{Binding ObracunskaJedinica}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="70"/>
                        <DataGridTextColumn Header="Am.Gr." Binding="{Binding AmGrupaFormatted}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stopa%" Binding="{Binding StopaAmortizacije, StringFormat=N2}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Koef.Reval." Binding="{Binding KoeficijentRevalorizacije, StringFormat=N4}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nabavna Vr." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ispravka Vr." Binding="{Binding IspravkaVrednosti, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sadašnja Vr." Binding="{Binding SadasnjaVrednostKumulativna, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2D6A4F"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
