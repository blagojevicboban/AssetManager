<Page x:Class="SredstvaApp.Views.Kartice.KarticePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Analitičke kartice"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MASTER PANE (Leva strana) -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Pretraga Sredstava" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                    <TextBox x:Name="SearchBox" Width="280" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <ListBox x:Name="SredstvaList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SredstvaList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding InventarskiBroj}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                                    <TextBlock Text="{Binding Naziv}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- DETAIL PANE (Desna strana) -->
        <Border x:Name="DetailPane" Grid.Column="2" Style="{StaticResource Card}" Visibility="Collapsed" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Naslov -->
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="NaslovText" Text="Naziv" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" Text="Inv Br" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Info kartice (stat boxes) -->
                <UniformGrid Grid.Row="2" Columns="4" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="NABAVNA VREDNOST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NabavnaText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                            <TextBlock Text="RSD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="ISPRAVKA VREDNOSTI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="IspravkaText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" FontFamily="Consolas"/>
                            <TextBlock Text="RSD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="SADAŠNJA VREDNOST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SadasnjaText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                            <TextBlock Text="RSD" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="STOPA AMORTIZACIJE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StopaText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                            <TextBlock Text="godišnje" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Meta podaci sredstva -->
                <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INVENTARSKI BROJ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="InvBrText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AMORT. GRUPA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="AmGrupaText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DATUM AKTIVIRANJA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DatumAktText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="BROJ STAVKI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="BrojStavkiText" Text="—" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabela kartica -->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#F0F7F4" CornerRadius="10,10,0,0" Padding="16,10">
                        <TextBlock Text="Hronologija promena" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryLightBrush}"/>
                    </Border>
                    
                    <DataGrid x:Name="KarticaGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Opis promene" Binding="{Binding OpisPromene}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="70"/>
                            <DataGridTextColumn Header="Am.Gr." Binding="{Binding AmGrupaFormatted}" Width="50"/>
                            <DataGridTextColumn Header="Stopa%" Binding="{Binding StopaAmortizacije, StringFormat=N2}" Width="60"/>
                            <DataGridTextColumn Header="Nabavna Vr." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Ispravka Vr." Binding="{Binding IspravkaVrednosti, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Sadašnja Vr." Binding="{Binding SadasnjaVrednostKumulativna, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#2D6A4F"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- Placeholder kada ništa nije izabrano -->
        <Border x:Name="EmptyPane" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="Izaberite sredstvo sa leve strane" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="Detalji analitičke kartice će se prikazati ovde." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
