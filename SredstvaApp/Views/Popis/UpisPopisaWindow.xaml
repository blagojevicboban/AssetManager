<Window x:Class="SredstvaApp.Views.Popis.UpisPopisaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upis stanja popisa" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtNaslov" Text="Popisna lista" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="TxtPodaci" Text="Komisija: ... | Datum: ..." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="StavkeGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      BorderThickness="0"
                      RowEditEnding="StavkeGrid_RowEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inv. Broj" Binding="{Binding Sredstvo.InventarskiBroj}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Naziv sredstva" Binding="{Binding Sredstvo.Naziv}" IsReadOnly="True" Width="*" MinWidth="200"/>
                    
                    <DataGridTextColumn Header="Knj. Količina" Binding="{Binding KnjiznaKolicina}" IsReadOnly="True" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Editable column -->
                    <DataGridTextColumn Header="Stvarna Kol." Binding="{Binding PopisanaKolicina, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    
                    <!-- Calculated Razlika -->
                    <DataGridTextColumn Header="Razlika" Binding="{Binding Razlika}" IsReadOnly="True" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImaRazliku}" Value="True">
                                        <Setter Property="Foreground" Value="#E63946"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Editable column -->
                    <DataGridTextColumn Header="Proc. Vrednost" Binding="{Binding ProcenjenaVrednost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Napomena" Binding="{Binding Napomena, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="🖨️" Width="36" Height="36" Padding="0" ToolTip="Štampaj obrazac" Style="{StaticResource OutlineButton}"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Otkaži" Width="100" Height="36" Style="{StaticResource OutlineButton}" Margin="0,0,12,0" Click="BtnOtkazi_Click"/>
                <Button x:Name="BtnSacuvaj" Content="Sačuvaj stanje" Width="130" Height="36" Style="{StaticResource PrimaryButton}" Click="BtnSacuvaj_Click"/>
                <Button x:Name="BtnZakljuci" Content="Zaključi popis" Width="130" Height="36" Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Margin="12,0,0,0" Click="BtnZakljuci_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
