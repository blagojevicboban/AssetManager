<Page x:Class="SredstvaApp.Views.Popis.PopisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Popisne Liste"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sadržaj (Tabs) -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            
            <!-- POPISI -->
            <TabItem Header="Popisne liste" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Godina:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbGodina" Width="100" Height="34" SelectionChanged="CmbGodina_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📝 Novi popis" Style="{StaticResource PrimaryButton}" Height="34" Click="BtnNoviPopis_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="PopisGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MouseDoubleClick="PopisGrid_DoubleClick"
                                  SelectionChanged="PopisGrid_SelectionChanged"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Datum Popisa" Binding="{Binding DatumPopisa, StringFormat=dd.MM.yyyy}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Godina" Binding="{Binding Godina}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Komisija" Binding="{Binding Komisija.Naziv}" Width="*" MinWidth="150"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Margin="4,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Zavrsen">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UToku">
                                                                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Akcije" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Obriši" Style="{StaticResource DangerButton}" 
                                                    Height="28" FontSize="11" Padding="4,2"
                                                    Click="BtnObrisiPopis_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Akcije štampanja -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnStampaPrazne" Content="🖨️"
                                    Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" ToolTip="Štampaj Praznu Listu" Margin="0,0,12,0"
                                    IsEnabled="False" Click="BtnStampaPrazne_Click" />
                            <Button x:Name="BtnStampaIzvestaj" Content="🖨️"
                                    Style="{StaticResource PrimaryButton}" Width="34" Height="34" Padding="0" ToolTip="Štampaj Izveštaj o Popisu"
                                    IsEnabled="False" Click="BtnStampaIzvestaj_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- KOMISIJE -->
            <TabItem Header="Komisije" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Leva strana: Komisije -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Spisak komisija" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="👥 Nova komisija" Style="{StaticResource PrimaryButton}" Height="34" Click="BtnNovaKomisija_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="KomisijeGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionChanged="KomisijeGrid_SelectionChanged"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Naziv Komisije" Binding="{Binding Naziv}" Width="*" MinWidth="150"/>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DatumKreiranja, StringFormat=dd.MM.yyyy}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="Aktivna" Binding="{Binding JeAktivna}" Width="70"/>
                                    <DataGridTemplateColumn Header="Akcije" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑 Obriši" Style="{StaticResource DangerButton}" 
                                                        Height="28" FontSize="11" Padding="4,2"
                                                        Click="BtnObrisiKomisija_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Desna strana: Članovi -->
                    <Grid Grid.Column="2" IsEnabled="False" x:Name="PanelClanovi">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="Novi član" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                <TextBlock Text="Ime i prezime:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtImeClana" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="8,0"/>
                                
                                <TextBlock Text="Uloga:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbUlogaClana" Height="32" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Član" IsSelected="True"/>
                                    <ComboBoxItem Content="Predsednik"/>
                                </ComboBox>
                                
                                <Button Content="➕ Dodaj člana" Style="{StaticResource SecondaryButton}" Height="34" Click="BtnDodajClana_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="ClanoviGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImePrezime}" Width="*"/>
                                    <DataGridTextColumn Header="Uloga" Binding="{Binding Uloga}" Width="80"/>
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ukloni" Style="{StaticResource DangerButton}" 
                                                        Height="26" FontSize="11" Padding="4,2"
                                                        Click="BtnObrisiClana_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
