<Page x:Class="SredstvaApp.Views.Firme.FirmePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="FirmePage" Background="{StaticResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20,15" Margin="0,0,0,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Rad sa firmama" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Odaberite firmu sa kojom želite da radite" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SADRŽAJ -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <TextBlock x:Name="SearchPlaceholder" Text="Pretraga po nazivu ili mestu..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="Black" 
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="FirmeGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" SelectionChanged="FirmeGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv firme" Binding="{Binding Naziv}" Width="*" />
                        <DataGridTextColumn Header="Mesto" Binding="{Binding Mesto}" Width="150" />
                        <DataGridTextColumn Header="PIB" Binding="{Binding PIB}" Width="120" />
                        <DataGridTextColumn Header="Matični broj" Binding="{Binding MaticniBroj}" Width="120" />
                        
                        <DataGridTemplateColumn Header="Akcije" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Postavi kao aktivnu" Click="BtnPostaviAktivnu_Click" 
                                            Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
